{
  "name": "azaria-ai-agency",
  "version": "1.0.0",
  "description": "Azaria AI Agency - MCP Server & Cloudflare Worker for site management, analytics, and maintenance",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "build": "next build",
    "worker:dev": "wrangler dev src/index.js --local",
    "worker:deploy": "wrangler deploy",
    "worker:tail": "wrangler tail",
    "pages:dev": "npx @cloudflare/next-on-pages",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "keywords": [
    "mcp",
    "azaria-ai",
    "cloudflare",
    "workers",
    "ai-agency"
  ],
  "author": "Evans Mathibe",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "octokit": "^3.1.0"
  },
  "devDependencies": {
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wrangler": "^4.0.0"
  }
}
